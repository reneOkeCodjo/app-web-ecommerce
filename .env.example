# Environnement : local, test ou production.
APP_ENV=local

# Fuseau horaire utilisé pour les dates et les journaux.
APP_TIMEZONE=Europe/Paris

# Connexion MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=site_de_vente
DB_USER=root
DB_PASSWORD=

# Mot de passe root MySQL (utile pour Docker uniquement).
MYSQL_ROOT_PASSWORD=
